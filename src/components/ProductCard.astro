---
interface Props {
  id: string;
  product: {
    name: string;
    status: 'open' | 'closed';
    tagline: string;
    platforms: string[];
    capabilities: { key: string; value: string }[];
    demoVideo: string | null;
    demoPoster: string | null;
    gallery: { src: string; caption: string }[];
    architecture: { title: string; items: string[] }[];
    links: { github?: string; store?: string; storeChrome?: string; storeEdge?: string; contact?: string };
    body: string;
  };
}

const { id, product } = Astro.props;
const i18n = (key: string) => `product.${id}.${key}`;
const isEmail = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
---

<article class="product-card">
  <div class="product-head">
    <div>
      <div class="product-title" data-i18n={i18n('name')}>{product.name}</div>
    </div>
    <span class={`badge badge-${product.status}`} data-i18n={product.status === 'open' ? 'badge.open' : 'badge.closed'}>
      {product.status === 'open' ? 'Open Source' : 'Closed Source'}
    </span>
  </div>

  <p class="product-tagline" data-i18n={i18n('tagline')}>{product.tagline}</p>

  <div class="product-platforms">
    {product.platforms.map((p) => <span class="platform-chip">{p}</span>)}
  </div>

  {
    product.capabilities.length > 0 && (
      <div class="capabilities">
        {product.capabilities.map((cap, capIdx) => (
          <div class="cap-card">
            <div class="cap-key" data-i18n={i18n(`cap.${capIdx}.key`)}>{cap.key}</div>
            <div class="cap-value" data-i18n={i18n(`cap.${capIdx}.value`)}>{cap.value}</div>
          </div>
        ))}
      </div>
    )
  }

  {
    product.demoVideo ? (
      <div class="demo-block">
        <div class="demo-label" data-i18n="demo.livePreview">Live product demo</div>
        <div class="demo-video">
          <video
            controls
            controlsList="nodownload noplaybackrate noremoteplayback"
            disablePictureInPicture
            preload="metadata"
            playsinline
            src={product.demoVideo}
            poster={product.demoPoster ?? undefined}
          >
          </video>
        </div>
      </div>
    ) : product.status === 'closed' ? (
      <div class="demo-placeholder" data-i18n="demo.comingSoon">product demo preview — coming soon</div>
    ) : null
  }

  {
    product.gallery.length > 0 && (
      <div class="product-gallery">
        <div class="demo-label" data-i18n={i18n('galleryLabel')}>{id === 'lingolens' ? 'Extension surfaces' : 'Chaos engineering surfaces'}</div>
        <div class={`gallery-grid${product.gallery.length > 1 ? ' gallery-grid--multi' : ''}`}>
          {product.gallery.map((item, idx) => (
            <figure class={`gallery-item${idx === 0 && product.gallery.length > 1 ? ' gallery-item--feature' : ''}`}>
              <img src={item.src} alt={item.caption} loading="lazy" />
              <figcaption data-i18n={i18n(`gallery.${idx}.caption`)}>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    )
  }

  {
    product.architecture.length > 0 && (
      <div class="architecture">
        <div class="demo-label" data-i18n="demo.architecture">Architecture overview</div>
        <div class="arch-grid">
          {product.architecture.map((section, sIdx) => (
            <div class="arch-card">
              <div class="arch-title" data-i18n={i18n(`arch.${sIdx}.title`)}>{section.title}</div>
              <ul class="arch-list">
                {section.items.map((item, iIdx) => (
                  <li data-i18n={i18n(`arch.${sIdx}.item.${iIdx}`)}>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    product.body && (
      <p class="product-tagline" data-i18n={i18n('body')}>{product.body}</p>
    )
  }

  <div class="product-links">
    {product.links.github && <a class="link-pill" href={product.links.github} target="_blank" rel="noopener noreferrer" data-i18n="btn.github">GitHub ↗</a>}
    {product.links.storeEdge && <a class="link-pill" href={product.links.storeEdge} target="_blank" rel="noopener noreferrer" data-i18n="btn.storeEdge">Edge Add-ons ↗</a>}
    {product.links.storeChrome && <a class="link-pill" href={product.links.storeChrome} target="_blank" rel="noopener noreferrer" data-i18n="btn.storeChrome">Chrome Web Store ↗</a>}
    {product.links.store && !product.links.storeEdge && !product.links.storeChrome && (
      <a class="link-pill" href={product.links.store} target="_blank" rel="noopener noreferrer" data-i18n="btn.store">Store ↗</a>
    )}
    {product.links.contact && isEmail(product.links.contact) ? (
      <button type="button" class="link-pill contact-mailto" data-email={product.links.contact} data-i18n="btn.contact">Contact</button>
    ) : product.links.contact ? (
      <a class="link-pill" href={product.links.contact} data-i18n="btn.contact">Contact ↗</a>
    ) : null}
  </div>
</article>

<script>
  import '../scripts/mailto-dialog.ts';
</script>
